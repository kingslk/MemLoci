# MemLoci 本地配置模板
#
# 第一次使用：
#   1. 复制：cp .env.example .env
#   2. 只编辑 .env，不要把真实 Secret 填回本文件
#   3. 从仓库根目录启动 API、Worker 或 MCP，程序会读取根目录下的 .env
#
# 配置优先级：启动进程的环境变量 > .env > 代码默认值。
# .env 已被 .gitignore 忽略；ADMIN_TOKEN、MCP_TOKEN、GITLAB_TOKEN、OPENAI_API_KEY
# 和 GITLAB_WEBHOOK_SECRET 都属于 Secret，不能提交、写入 URL 或日志。

# ---------- 应用与管理接口 ----------
# 应用名称，只用于 API 标题和日志识别。
APP_NAME=MemLoci
# development/test/production。当前主要用于区分部署环境和排障，不会自动切换数据库。
APP_ENV=development
# 管理接口认证值。Web Console 会让操作者在页面输入，不会从 VITE_* 注入前端构建物。
ADMIN_TOKEN=change-me
# 远程 MCP / Agent 只读 Token。客户端用 Authorization: Bearer <MCP_TOKEN>。
# 留空则回退到 ADMIN_TOKEN；生产应单独设置，避免把管理员凭证写进 Agent 配置。
MCP_TOKEN=

# ---------- 数据库 ----------
# 本地和测试都使用 PostgreSQL。请先自行启动本机 PostgreSQL（及 Worker 所需的 Redis）。
DATABASE_URL=postgresql+psycopg://memloci:memloci@127.0.0.1:5432/memloci
# pytest 默认使用同实例上的 memloci_test，可用 TEST_DATABASE_URL 覆盖。
# 修改 DATABASE_URL 后，必须在同一环境执行：uv run alembic upgrade head

# ---------- 异步 Worker ----------
# 只有启动 Dramatiq Worker 时才需要 Redis；API 的同步接口不依赖它。
REDIS_URL=redis://localhost:6379/0

# ---------- GitLab（实例级配置） ----------
# GitLab 实例根地址，不要填写 /api/v4；代码会自动拼接 /api/v4。
GITLAB_BASE_URL=https://gitlab.example.com
# 能访问多个 Repo 的服务账号 Token。Repo 的 project ID、clone URL、branch
# 不在这里配置，而是在 Web Console/API 的 Repository 设置中逐个填写。
GITLAB_TOKEN=
# 所有 MemLoci Repo Webhook 共用的校验 Secret。每个 GitLab 项目的 Webhook
# 都填写这个值；MemLoci 仍校验 Payload 中的 GitLab Project ID 是否匹配 URL 对应 Repo。
GITLAB_WEBHOOK_SECRET=
# 内网自签证书设为 false。需要校验证书时改为 true。
GITLAB_SSL_VERIFY=false

# Mirror 是 GitLab 的本地只读缓存，不是事实源；删除后可从 GitLab 重建。
MIRROR_ROOT=./mirrors

# ---------- 外部 LLM（默认必填） ----------
# v1 默认调用 OpenAI-compatible API，不再默认使用本地 heuristic。
LLM_PROVIDER=openai
# 模型名称由你的 API 服务决定；gpt-4o-mini 只是常见默认值，可按服务商修改。
LLM_MODEL=gpt-4o-mini
# 推理强度，默认 medium；明确冲突的复核会临时升到 high。
# 可选 none/minimal/low/medium/high/xhigh/max；留空则不下发。
LLM_REASONING_EFFORT=medium
# 正式分支更新只生成 Candidate；开启后由 Worker 每天夜间统一整理新变更。
AUTO_DREAM_ENABLED=false
# 0-23 点；Worker 在当天到达该小时后补跑一次。
AUTO_DREAM_HOUR=3
AUTO_DREAM_TIMEZONE=UTC
# 外部模型 API Key，必须由用户/部署平台注入。
OPENAI_API_KEY=
# API Base URL，必须由用户填写；官方 OpenAI 通常是 https://api.openai.com/v1，
# 兼容服务也可以填写自己的 /v1 地址。不要填具体聊天接口路径。
OPENAI_BASE_URL=
# 模型网关也是自签证书时保持 false。
LLM_SSL_VERIFY=false
# 如果 LLM_PROVIDER=openai，OPENAI_API_KEY 和 OPENAI_BASE_URL 缺一不可。
# 只有测试显式设置 LLM_PROVIDER=heuristic 时，才不需要这两个值。

# ---------- Embedding ----------
# 当前不是语义模型，也没有安装 sentence-transformers / 本地 embedding 服务。
# HashEmbeddingProvider 用 SHA-256 生成确定性向量，供开发检索打分；不调用外部 Embedding API。
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=hash-384
EMBEDDING_DIMENSIONS=384

# ---------- 日志与 Web ----------
LOG_LEVEL=INFO
WEB_ORIGIN=http://localhost:5173

# ---------- 记忆检索（改完必须重启 API 和 MCP） ----------
# 只影响「问一句回哪几条」，不改库里的记忆。一次只改一两个数。
#
# 金标经常根本没出现 → 把下面「多松才能进候选」调松，或把候选袋加大。
# 回了一堆跑题的 → 把那几项调紧。
# 对的条在第 2～4 名 → 先看 TITLE_BLEND / DISTINCTIVE_BONUS，不要先砍候选袋。

# 最终交给 Agent 的条数。
RECALL_TOP_K=4

# 用词有多重要。越大越听提问里的词，越小越听仓库加分。
RECALL_KEYWORD_WEIGHT=0.4
# 要不要用本地 hash 向量。现在不是真语义，保持 0。
RECALL_VECTOR_WEIGHT=0
# 已人工启用的记忆额外加多少。试用稿没有这项。
RECALL_ACTIVE_BONUS=0.1

# 先挑一批候选，再从里面取出上面的 TOP_K。
# 袋太小：对的条进不来。袋太大：后面排序更累，也可能掺进弱相关。
RECALL_POOL_SIZE=12
# 一条记忆至少要对上提问里多少「有效词」才进候选。
# 0.03 很松；调到 0.1 会少回、更干净。
RECALL_SIGNAL_FLOOR=0.03
# 比第一名差多少还留着。0.2 表示大约是第一名两成信号就留。
RECALL_SIGNAL_RATIO=0.2
# 提问很长时，只按前几个有效词算「对上了没有」，避免越问越空。
RECALL_HIT_CAP=6

# 看标题还是看正文。0.35 = 标题三成、正文七成。标题很杂就再调低。
RECALL_TITLE_BLEND=0.35
# 同一批结果里，只有某条对上的词，给它加点分。true 开启。
RECALL_DISTINCTIVE_RERANK=true
# 上面那种「独有词」加多少。0.12 是轻推，不会只凭这个改第一名。
RECALL_DISTINCTIVE_BONUS=0.12

# 用户说「不是金额」时，带「金额」的条打几折。1 表示不打折。
RECALL_NEGATIVE_PENALTY=0.35
# 同一会话里刚回过的第一条，下一句澄清时打几折。1 表示不打折。
RECALL_PREVIOUS_TOP_PENALTY=0.45

# 没点名仓库时，名字和提问更像的仓最低加多少、最多能再加多少。
RECALL_REPO_WEIGHT_MIN=0.04
RECALL_REPO_WEIGHT_SPAN=0.12
RECALL_HINT_AFFINITY_FLOOR=0.35
RECALL_AFFINITY_HIT_BASE=0.55
RECALL_AFFINITY_HIT_SPAN=0.45
# 调用时传了 repo，这个仓至少加这么多分。别的仓照样能凭用词排进来。
RECALL_HINT_WEIGHT_FLOOR=0.16
# true：传了 repo 就把它标成主仓（只是标签和加分）。false：谁仓名更像提问谁当主仓。
RECALL_KEEP_HINT_PRIMARY=true

# true：提问只剩 scss、css 这种扩展名时，直接不回，避免乱抓一条。
RECALL_GENERIC_ONLY_EMPTY=true
